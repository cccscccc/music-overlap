# 依赖（本项目其实零依赖，这里只是防手滑）
node_modules/

# 自检产物：截图会包含真实歌单名和头像，记录里含他人昵称，不上传
_dev/page.png
_dev/shot-*.png
_dev/自检记录_*.txt
_dev/自检结果_*.json

# 便携包是构建产物（88MB，且里面那份 node.exe 不该进版本库）
# 用 _dev/build-portable.mjs 随时可以重新打出来
dist/

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/

# 提交信息临时文件（git commit -F 用，别进版本库）
.commit-msg*.tmp

# 服务的启动信息（--print-port 时写出来给「手机访问」启动器读，退出时自己删）
.started.json
.started.url
.started.log
