# 依赖（本项目其实零依赖，这里只是防手滑）
node_modules/

# 自检产物：截图会包含真实歌单名和头像，记录里含他人昵称，不上传
_dev/page.png
_dev/shot-*.png
_dev/自检记录_*.txt
_dev/自检结果_*.json

# 便携包是构建产物（88MB，且里面那份 node.exe 不该进版本库）
# 用 _dev/build-portable.mjs 随时可以重新打出来
dist/

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
*.log
.idea/
.vscode/

# 提交信息临时文件（git commit -F 用，别进版本库）
.commit-msg*.tmp

# 服务的启动信息（--print-port 时写出来给「手机访问」启动器读，退出时自己删）
.started.json
.started.url
.started.log

# 安卓：工具链和构建中间产物（几百 MB，谁要谁自己装，见 android/README.md）
android/.jdk/
android/.sdk/
android/.dl/
android/build/

# 安卓签名密钥：自用调试签名，按需生成，不进版本库
# （换机器重新构建会得到不同证书，覆盖安装会失败——先卸载旧版）
android/debug.keystore

# 临时重定向输出（本地调试服务时顺手写的）
.srv.out
.srv.err
